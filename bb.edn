{:tasks
 {dev             {:doc  "Start nREPL server"
                   :task (shell "clj -M:dev -m nrepl.cmdline --interactive")}

  test            {:doc  "Run tests"
                   :task (shell (str "clj -M:test " (clojure.string/join " " *command-line-args*)))}

  build           {:doc  "Build library JAR"
                   :task (shell "clj -T:build jar")}

  install         {:doc  "Install JAR to local Maven repo"
                   :task (shell "clj -T:build install")}

  tag             {:doc  "Create and push version tag"
                   :task (shell "clj -T:build tag")}

  version:check   {:doc  "Check the version in build.clj is reflected in the docs and the MCP server-info"
                   :task (let [version (second (re-find (re-pattern "\\(def version \"([^\"]+)\"\\)") (slurp "build.clj")))
                               sources {"README.md"                            (re-pattern (str "co\\.multiply/remontoire \\{:mvn/version \"" version "\"\\}"))
                                        "src/co/multiply/remontoire/mcp.clj"   (re-pattern (str ":version \"" version "\""))
                                        "CHANGELOG.md"                         (re-pattern (str "## " version " "))}
                               stale   (remove (fn [[f re]] (re-find re (slurp f))) sources)]
                           (if (seq stale)
                             (do (println "Version" version "(build.clj) is not reflected in:")
                               (doseq [[f _] stale] (println "  -" f))
                               (System/exit 1))
                             (println "Version" version "in sync.")))}

  deploy          {:doc     "Tag, push, and deploy to Clojars"
                   :depends [version:check]
                   :task    (do (shell "clj -T:build tag")
                              (shell "clj -T:build deploy"))}

  cljdoc          {:doc     "Test cljdoc analysis locally"
                   :depends [build]
                   :task    (let [v (clojure.string/trim (:out (shell {:out :string} "clj -T:build version-str")))]
                              (shell "clj -M:cljdoc"
                                (format "{:project \"co.multiply/remontoire\" :version \"%s\" :jarpath \"target/remontoire-%s.jar\" :pompath \"target/classes/META-INF/maven/co.multiply/remontoire/pom.xml\"}"
                                  v v)))}

  warn:reflection {:doc  "Check for reflection and performance warnings"
                   :task (shell "clj" "-M" "-e" "(set! *warn-on-reflection* true)" "-e" "(require 'co.multiply.remontoire)")}

  format:check    {:doc  "Check code formatting"
                   :task (shell "cljstyle check")}

  format:fix      {:doc  "Fix code formatting"
                   :task (shell "cljstyle fix")}}}
